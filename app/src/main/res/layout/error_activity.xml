<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:fitsSystemWindows="true"
    android:background="@drawable/frame_bg"
    android:orientation="vertical">

    <androidx.camera.view.PreviewView
        android:id="@+id/error_previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@null" />

    <LinearLayout
        android:id="@+id/frame_bg_error"
        android:orientation="vertical" 
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="#AA444444" />

    <RelativeLayout
        android:id="@+id/foreground_ui_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="244dp"
            android:layout_height="254dp"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:paddingTop="10dp" >

            <LinearLayout
                android:id="@+id/target_window_error_shadow"
                android:orientation="vertical"
                android:layout_width="244dp"
                android:layout_height="244dp"
                android:background="@drawable/target_shadow"
                android:backgroundTint="#770000"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/target_window_error"
            android:layout_width="244dp"
            android:layout_height="244dp"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:background="@drawable/target"
            android:orientation="vertical"
            android:padding="16dp"
            android:weightSum="8"
            android:backgroundTint="#FF0000">

            <ScrollView
                android:id="@+id/scrollView_error"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="6"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_title_error"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="2"
                        android:gravity="center"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="Viga"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@android:color/white" />

                    <TextView
                        android:id="@+id/text_message_error"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"
                        tools:text="Tehniline viga, palun teavitage valimiste korraldajat abi@valimised.ee"/>
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    style="@style/BaseButton"
                    android:id="@+id/btn_left"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="Abi"
                    tools:ignore="NestedWeights" />

                <Button
                    style="@style/BaseButton"
                    android:id="@+id/btn_right"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:visibility="gone"
                    tools:text="Ok"
                    tools:visibility="visible"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
